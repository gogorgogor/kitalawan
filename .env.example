# Required: Claude API key
ANTHROPIC_API_KEY=
# Optional: override the model (default claude-opus-5-5)
# CLAUDE_MODEL=claude-opus-5-5

# Optional: enables transcription of uploaded/recorded audio files.
# Any Whisper-compatible /audio/transcriptions endpoint works.
# TRANSCRIBE_API_KEY=
# TRANSCRIBE_API_URL=https://api.openai.com/v1/audio/transcriptions
# TRANSCRIBE_MODEL=whisper-1

# PORT=3000
